<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Serves files written by ChordExporter.share(); authority must match ChordExporter.authority() -->
        <provider
            android:name="com.guitarcharts.chord.compose.ChordDiagramFileProvider"
            android:authorities="${applicationId}.chorddiagram.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/chord_diagram_file_paths" />
        </provider>
    </application>

</manifest>
